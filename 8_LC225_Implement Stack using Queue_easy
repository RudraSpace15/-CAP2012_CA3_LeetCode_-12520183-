//Implement a last-in-first-out (LIFO) stack using only two queues. The implemented stack should support all the functions of a normal stack (push, top, pop, and empty).

#include <queue>
using namespace std;

class MyStack {
public:

    queue<int> q1;
    queue<int> q2;

    MyStack() {
        
    }

    void push(int x) {

        q2.push(x);

        while(!q1.empty())
        {
            q2.push(q1.front());
            q1.pop();
        }

        swap(q1, q2);
    }

    int pop() {

        int x = q1.front();
        q1.pop();

        return x;
    }

    int top() {

        return q1.front();
    }

    bool empty() {

        return q1.empty();
    }
};
